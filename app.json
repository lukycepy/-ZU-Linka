{
  "expo": {
    "name": "Linka",
    "slug": "pupen-linka",
    "version": "1.3.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#15803d"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.pupen.linka",
      "buildNumber": "10",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tel"
        ],
        "NSContactsUsageDescription": "Povolení přístupu ke kontaktům slouží k uložení kontaktu do telefonního seznamu, pokud si to uživatel přeje.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15803d"
      },
      "package": "org.pupen.linka",
      "versionCode": 6,
      "permissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CONTACTS",
        "android.permission.CALL_PHONE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Linka od Pupenu",
      "shortName": "Linka",
      "description": "Rychlé vyhledávání a vytáčení interních telefonních linek. Projekt Studentského spolku Pupen, z.s."
    },
    "extra": {
      "eas": {
        "projectId": "11e5c78e-36e2-4f55-b1ab-922ab43c676e"
      }
    },
    "scheme": "pupen-linka",
    "owner": "lukycepy",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/11e5c78e-36e2-4f55-b1ab-922ab43c676e"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.0"
          }
        }
      ]
    ]
  }
}
